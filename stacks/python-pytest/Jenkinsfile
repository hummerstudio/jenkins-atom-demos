pipeline {
  agent any
  stages {
    stage('build and test') {
      steps { dir('stacks/python-pytest') {
        runAtom(atom: 'script', version: '1.latest', inputs: [
          interpreter: 'sh',
          script: 'set -eu\npython3 -m pip install --user -q -r requirements.txt\nmkdir -p reports\npython3 -m pytest -q --junitxml=reports/junit.xml'
        ])
      } }
    }
    stage('report') {
      steps { dir('stacks/python-pytest') {
        runAtom(atom: 'junit', version: '1.latest',
                inputs: [testResults: 'reports/junit.xml', label: 'Python 单元测试'])
      } }
    }
  }
}
