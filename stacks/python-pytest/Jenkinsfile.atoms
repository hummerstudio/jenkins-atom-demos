pipeline {
  agent any
  stages {
    stage('clean') {
      steps { runAtom(atom: 'ws-cleanup', version: '1.2.0', inputs: [patterns: '**', deleteDirs: 'true']) }
    }
    stage('checkout') {
      steps { runAtom(atom: 'git-checkout', version: '1.0.0',
                      inputs: [url: 'file:///Users/tangming/repos/jenkins-atom-demos.git', branch: 'main']) }
    }
    stage('build and test') {
      steps { dir('stacks/python-pytest') {
        runAtom(atom: 'script', version: '1.0.1', inputs: [
          interpreter: 'bash',
          script: 'set -euo pipefail\nrm -rf reports\nmkdir -p reports\npython3 -m pytest -q\n'
        ])
      } }
    }
    stage('report') {
      steps { dir('stacks/python-pytest') {
        runAtom(atom: 'junit', version: '1.3.2',
                inputs: [testResults: 'reports/junit.xml', label: 'Python 单元测试'])
      } }
    }
  }
}
