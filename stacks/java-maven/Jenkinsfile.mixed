pipeline {
  agent any
  stages {
    stage('checkout') {
      steps { checkout scm }
    }
    stage('run') {
      steps {
        dir('stacks/java-maven') {
          sh 'mvn -B -ntp clean verify'
          runAtom(atom: 'junit', version: '1.latest', inputs: [testResults: 'target/surefire-reports/TEST-*.xml'])
          runAtom(atom: 'artifact-size', version: '1.latest', inputs: [pattern: 'target/*.jar', maxMb: '50'])
        }
      }
    }
  }
}
