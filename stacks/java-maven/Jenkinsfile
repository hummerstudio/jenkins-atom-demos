pipeline {
  agent any
  stages {
    stage('build and test') {
      steps { dir('stacks/java-maven') {
        runAtom(atom: 'maven', version: '1.latest', inputs: [goals: 'clean verify', options: '-B -ntp'])
      } }
    }
    stage('report') {
      steps { dir('stacks/java-maven') {
        runAtom(atom: 'junit', version: '1.latest',
                inputs: [testResults: 'target/surefire-reports/TEST-*.xml', label: 'Java 单元测试'])
        runAtom(atom: 'coverage', version: '1.latest',
                inputs: [pattern: 'target/site/jacoco/jacoco.xml', label: 'Java 覆盖率', minLine: '80'])
      } }
    }
    stage('gate') {
      steps { dir('stacks/java-maven') {
        runAtom(atom: 'artifact-size', version: '1.latest', inputs: [pattern: 'target/*.jar', maxMb: '50'])
      } }
    }
  }
}
