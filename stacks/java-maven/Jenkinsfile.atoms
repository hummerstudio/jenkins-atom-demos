pipeline {
  agent any
  stages {
    stage('clean') {
      steps { runAtom(atom: 'ws-cleanup', version: '1.2.0', inputs: [patterns: '**', deleteDirs: 'true']) }
    }
    stage('checkout') {
      steps { runAtom(atom: 'git-checkout', version: '1.0.0',
                      inputs: [url: 'file:///Users/tangming/repos/jenkins-atom-demos.git', branch: 'main']) }
    }
    stage('build and test') {
      steps { dir('stacks/java-maven') {
        runAtom(atom: 'maven', version: '1.2.0', inputs: [goals: 'clean verify', options: '-B -ntp'])
      } }
    }
    stage('report') {
      steps { dir('stacks/java-maven') {
        runAtom(atom: 'junit', version: '1.3.2',
                inputs: [testResults: '**/surefire-reports/TEST-*.xml', label: 'Java 单元测试'])
        runAtom(atom: 'coverage', version: '1.3.2',
                inputs: [pattern: 'target/site/jacoco/jacoco.xml', label: 'Java 覆盖率', minLine: '0'])
      } }
    }
    stage('gate') {
      steps { dir('stacks/java-maven') {
        runAtom(atom: 'artifact-size', version: '1.1.0', inputs: [pattern: '**/target/*.jar', maxMb: '50'])
      } }
    }
  }
}
