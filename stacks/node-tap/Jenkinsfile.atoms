pipeline {
  agent any
  stages {
    stage('test') {
      steps {
        runAtom(atom: 'git-checkout', inputs: [url: env.GIT_URL, branch: env.GIT_BRANCH])
        runAtom(atom: 'node', inputs: [command: 'npm test'])
        runAtom(atom: 'junit-report', inputs: [testResults: 'reports/junit.xml'])
        runAtom(atom: 'node', inputs: [command: 'npm run build'])
        runAtom(atom: 'zip-artifacts', inputs: [operation: 'zip', archive: 'out/dist.zip', includes: 'dist/**'])
      }
    }
  }
}
