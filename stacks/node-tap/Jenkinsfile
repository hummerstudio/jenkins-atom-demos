pipeline {
  agent any
  stages {
    stage('build and test') {
      steps { dir('stacks/node-tap') {
        runAtom(atom: 'node', version: '1.latest', inputs: [command: 'npm run build && npm test'])
      } }
    }
    stage('report') {
      steps { dir('stacks/node-tap') {
        runAtom(atom: 'junit', version: '1.latest',
                inputs: [testResults: 'reports/junit.xml', label: 'Node 单元测试'])
      } }
    }
  }
}
