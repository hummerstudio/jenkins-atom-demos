pipeline {
  agent any
  stages {
    stage('checkout') {
      steps { checkout scm }
    }
    stage('run') {
      steps {
        dir('stacks/cpp-cmake') {
          sh 'cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug'
          sh 'cmake --build build -j 4'
          sh 'ctest --test-dir build --output-on-failure --output-junit reports/ctest.xml'
          runAtom(atom: 'junit-report', version: '1.3.0', inputs: [testResults: 'build/reports/ctest.xml'])
        }
      }
    }
  }
}
