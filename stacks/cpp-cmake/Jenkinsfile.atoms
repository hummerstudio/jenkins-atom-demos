pipeline {
  agent any
  stages {
    stage('clean') {
      steps { runAtom(atom: 'ws-cleanup', version: '1.2.0', inputs: [patterns: '**', deleteDirs: 'true']) }
    }
    stage('checkout') {
      steps { runAtom(atom: 'git-checkout', version: '1.0.0',
                      inputs: [url: 'file:///Users/tangming/repos/jenkins-atom-demos.git', branch: 'main']) }
    }
    stage('build and test') {
      steps { dir('stacks/cpp-cmake') {
        runAtom(atom: 'cmake-build', version: '1.3.1', inputs: [
          source: '.', buildDir: 'build', buildType: 'Debug',
          runTests: 'true', outputJunit: 'reports/ctest.xml', failOnTestFailure: 'true'
        ])
      } }
    }
    stage('report') {
      steps { dir('stacks/cpp-cmake') {
        runAtom(atom: 'junit', version: '1.3.2',
                inputs: [testResults: 'build/reports/ctest.xml', label: 'C++ 单元测试'])
      } }
    }
  }
}
