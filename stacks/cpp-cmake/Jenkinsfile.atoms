pipeline {
  agent any
  stages {
    stage('build and test') {
      steps {
        // a stale workspace is how a demo reports six tests instead of three
        runAtom(atom: 'ws-cleanup', version: '1.2.0', inputs: [patterns: '**', deleteDirs: 'true'])
        runAtom(atom: 'git-checkout', version: '1.0.0', inputs: [url: env.GIT_URL ?: 'file:///Users/ming/repos/jenkins-atom-demos.git', branch: 'main'])
        dir('stacks/cpp-cmake') {
          runAtom(atom: 'cmake-build', version: '1.2.0', inputs: [buildType: 'Debug', jobs: '4', runTests: 'true',
                                                testArgs: '--output-junit reports/ctest.xml'])
          runAtom(atom: 'junit-report', version: '1.3.0', inputs: [testResults: 'build/reports/ctest.xml'])
        }
      }
    }
  }
}
