// deploy-war @ 1.0.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 这个原子要外部服务/凭据：失败会被记录，流水线保持成功（continueOnError）。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/deploy-war/fixtures ]; then cp -R atoms/deploy-war/fixtures/. .; fi'

      }
    }

    stage('deploy-war') {
      steps {
        runAtom(atom: 'deploy-war', version: '1.latest', inputs: [
            war: '**/*.war'
          ],
          continueOnError: true)
      }
    }
  }
}
