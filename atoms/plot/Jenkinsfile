// plot @ 1.0.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'data.csv', text: '''day,value
1,3
2,5
3,4
'''
      }
    }

    stage('plot') {
      steps {
        runAtom(atom: 'plot', version: '1.latest', inputs: [
            pattern: '**/*.csv',
            title: 'Plot',
            outputFile: 'out/plot/plot.svg'
          ])
      }
    }
  }
}
