// plot @ 1.0.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/plot/fixtures ]; then cp -R atoms/plot/fixtures/. .; fi'
      }
    }

    stage('plot') {
      steps {
        runAtom(atom: 'plot', version: '1.0.0', inputs: [
            pattern: '**/*.csv',
            title: 'Plot',
            outputFile: 'out/plot/plot.svg'
          ])
      }
    }
  }
}
