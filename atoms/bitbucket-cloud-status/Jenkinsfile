// bitbucket flavor=cloud（原 bitbucket-cloud-status） — 作业路径不变
// 这个原子要外部服务/凭据：失败会被记录，流水线保持成功（continueOnError）。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('bitbucket-cloud-status') {
      steps {
        runAtom(atom: 'bitbucket', version: '1.latest', inputs: [
            flavor: 'cloud'
          ],
          continueOnError: true)
      }
    }
  }
}
