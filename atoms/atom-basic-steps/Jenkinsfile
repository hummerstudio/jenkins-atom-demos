// atom-basic-steps @ 1.0.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/atom-basic-steps/fixtures ]; then cp -R atoms/atom-basic-steps/fixtures/. .; fi'

      }
    }

    stage('atom-basic-steps') {
      steps {
        runAtom(atom: 'atom-basic-steps', version: '1.0.0', inputs: [
            action: 'rename',
            displayName: '#${BUILD_NUMBER}',
            jenkinsUrl: '${JENKINS_URL}',
            rebuildJob: '${JOB_NAME}'
          ])
      }
    }
  }
}
