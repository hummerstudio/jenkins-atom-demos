// aws-codedeploy @ 1.0.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 这个原子要外部服务/凭据：失败会被记录，流水线保持成功（continueOnError）。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/aws-codedeploy/fixtures ]; then cp -R atoms/aws-codedeploy/fixtures/. .; fi'

      }
    }

    stage('aws-codedeploy') {
      steps {
        runAtom(atom: 'aws-codedeploy', version: '1.latest', inputs: [
            deploymentConfig: 'CodeDeployDefault.OneAtATime',
            bundleType: 'zip',
            description: 'deployed by a Jenkins atom'
          ],
          continueOnError: true)
      }
    }
  }
}
