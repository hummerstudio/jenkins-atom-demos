// gitea @ 1.0.0 — 原子测试流水线；它需要的输入文件都写在这里
// 这个原子要外部服务/凭据：失败会被记录，流水线保持成功（continueOnError）。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('gitea') {
      steps {
        runAtom(atom: 'gitea', version: '1.latest', inputs: [
            action: 'status',
            context: 'jenkins/atom',
            pendingDescription: 'Build started...'
          ],
          continueOnError: true)
      }
    }
  }
}
