// aws-codepipeline @ 1.0.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 这个原子要外部服务/凭据：失败会被记录，流水线保持成功（continueOnError）。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/aws-codepipeline/fixtures ]; then cp -R atoms/aws-codepipeline/fixtures/. .; fi'

      }
    }

    stage('aws-codepipeline') {
      steps {
        runAtom(atom: 'aws-codepipeline', version: '1.0.0', inputs: [
            action: 'start',
            result: 'success',
            summary: 'Finished'
          ],
          continueOnError: true)
      }
    }
  }
}
