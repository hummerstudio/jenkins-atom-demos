// script @ 1.1.1 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('script') {
      steps {
        runAtom(atom: 'script', version: '1.latest', inputs: [
            interpreter: 'sh',
            script: 'echo hello from the script atom'
          ])
      }
    }
  }
}
