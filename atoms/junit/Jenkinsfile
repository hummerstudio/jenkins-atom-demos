// junit @ 1.3.2 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'target/surefire-reports/TEST-demo.SampleTest.xml', text: '''<?xml version="1.0" encoding="UTF-8"?>
<testsuite name="demo.SampleTest" tests="2" failures="0" errors="0" skipped="0" time="0.021">
  <testcase name="passes" classname="demo.SampleTest" time="0.012"/>
  <testcase name="alsoPasses" classname="demo.SampleTest" time="0.009"/>
</testsuite>
'''
      }
    }

    stage('junit') {
      steps {
        runAtom(atom: 'junit', version: '1.latest', inputs: [
            testResults: '**/surefire-reports/*.xml'
          ])
      }
    }
  }
}
