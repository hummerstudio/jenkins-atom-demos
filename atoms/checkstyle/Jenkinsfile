// checkstyle @ 1.2.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'target/checkstyle-result.xml', text: '''<?xml version="1.0" encoding="UTF-8"?>
<checkstyle version="10.0"><file name="src/main/java/demo/App.java"></file></checkstyle>
'''
      }
    }

    stage('checkstyle') {
      steps {
        runAtom(atom: 'checkstyle', version: '1.latest', inputs: [
            pattern: '**/checkstyle-result.xml, **/pmd.xml, **/spotbugsXml.xml, **/cppcheck*.xml'
          ])
      }
    }
  }
}
