// checkstyle @ 1.2.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/checkstyle/fixtures ]; then cp -R atoms/checkstyle/fixtures/. .; fi'
      }
    }

    stage('checkstyle') {
      steps {
        runAtom(atom: 'checkstyle', version: '1.2.0', inputs: [
            pattern: '**/checkstyle-result.xml, **/pmd.xml, **/spotbugsXml.xml, **/cppcheck*.xml'
          ])
      }
    }
  }
}
