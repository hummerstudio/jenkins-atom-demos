// cmake-build @ 1.3.1 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/cmake-build/fixtures ]; then cp -R atoms/cmake-build/fixtures/. .; fi'

      }
    }

    stage('cmake-build') {
      steps {
        runAtom(atom: 'cmake-build', version: '1.3.1', inputs: [
            source: '.',
            buildDir: 'build',
            buildType: 'Release'
          ])
      }
    }
  }
}
