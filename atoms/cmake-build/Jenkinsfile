// cmake-build @ 1.3.1 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'CMakeLists.txt', text: '''cmake_minimum_required(VERSION 3.10)
project(demo C)
add_executable(demo hello.c)
'''
        writeFile file: 'hello.c', text: '''int main(void) { return 0; }
'''
      }
    }

    stage('cmake-build') {
      steps {
        runAtom(atom: 'cmake-build', version: '1.latest', inputs: [
            source: '.',
            buildDir: 'build',
            buildType: 'Release'
          ])
      }
    }
  }
}
