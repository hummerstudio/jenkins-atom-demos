// build-time-blame @ 1.0.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/build-time-blame/fixtures ]; then cp -R atoms/build-time-blame/fixtures/. .; fi'
      }
    }

    stage('build-time-blame') {
      steps {
        runAtom(atom: 'build-time-blame', version: '1.0.0', inputs: [
            timestampFormat: 'elapsedMillis'
          ])
      }
    }
  }
}
