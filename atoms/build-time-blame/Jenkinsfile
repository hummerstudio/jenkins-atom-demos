// build-time-blame @ 1.0.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'build-time.log', text: '''0 Start of build
1500 compile
9000 test
21500 package
32000 done
'''
      }
    }

    stage('build-time-blame') {
      steps {
        runAtom(atom: 'build-time-blame', version: '1.latest', inputs: [
            timestampFormat: 'elapsedMillis',
            logFile: 'build-time.log',
            steps: '[{"key": "compile", "label": "编译"}, {"key": "test", "label": "测试"}, {"key": "package", "label": "打包"}]'
          ])
      }
    }
  }
}
