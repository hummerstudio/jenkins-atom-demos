// warnings @ 1.0.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'build.log', text: '''2026-11-04 10:00:00 INFO starting
2026-11-04 10:00:01 WARN slow step
2026-11-04 10:00:02 ERROR boom
'''
      }
    }

    stage('warnings') {
      steps {
        runAtom(atom: 'warnings', version: '1.latest', inputs: [
            pattern: '**/build.log, **/*.log, **/warnings*.txt',
            maxWarnings: '-1'
          ])
      }
    }
  }
}
