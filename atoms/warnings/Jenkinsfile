// warnings @ 1.0.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/warnings/fixtures ]; then cp -R atoms/warnings/fixtures/. .; fi'
      }
    }

    stage('warnings') {
      steps {
        runAtom(atom: 'warnings', version: '1.0.0', inputs: [
            pattern: '**/build.log, **/*.log, **/warnings*.txt',
            maxWarnings: '-1'
          ])
      }
    }
  }
}
