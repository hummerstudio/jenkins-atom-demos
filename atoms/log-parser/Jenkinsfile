// log-parser @ 1.0.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/log-parser/fixtures ]; then cp -R atoms/log-parser/fixtures/. .; fi'

      }
    }

    stage('log-parser') {
      steps {
        runAtom(atom: 'log-parser', version: '1.0.0', inputs: [
            source: 'build.log',
            rules: '{"error": "ERROR|Exception"}'
          ])
      }
    }
  }
}
