// log-parser @ 1.0.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'clean.log', text: '''2026-11-04 10:00:00 INFO starting
2026-11-04 10:00:01 INFO compiling
2026-11-04 10:00:02 INFO finished
'''
      }
    }

    stage('log-parser') {
      steps {
        runAtom(atom: 'log-parser', version: '1.latest', inputs: [
            source: 'clean.log',
            rules: '{"note": "WARN"}'
          ])
      }
    }
  }
}
