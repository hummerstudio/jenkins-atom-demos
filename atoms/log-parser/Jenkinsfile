// atom-basic-steps action=parse-log（原 log-parser） — 作业路径不变
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'clean.log', text: '''2026-11-04 10:00:00 INFO starting
2026-11-04 10:00:01 INFO compiling
2026-11-04 10:00:02 INFO finished
'''
      }
    }

    stage('log-parser') {
      steps {
        runAtom(atom: 'atom-basic-steps', version: '1.latest', inputs: [
            action: 'parse-log',
            source: 'clean.log',
            rules: '{"note": "WARN"}'
          ])
      }
    }
  }
}
