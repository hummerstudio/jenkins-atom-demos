// jmeter @ 1.2.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'results.jtl', text: '''<?xml version="1.0" encoding="UTF-8"?>
<testResults version="1.2">
  <httpSample t="12" lt="12" ts="1762300000000" s="true" lb="GET /" rc="200" rm="OK" tn="Thread Group 1-1" by="120"/>
</testResults>
'''
      }
    }

    stage('jmeter') {
      steps {
        runAtom(atom: 'jmeter', version: '1.latest', inputs: [
            pattern: '**/*.jtl'
          ])
      }
    }
  }
}
