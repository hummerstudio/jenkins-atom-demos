// jmeter @ 1.2.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/jmeter/fixtures ]; then cp -R atoms/jmeter/fixtures/. .; fi'

      }
    }

    stage('jmeter') {
      steps {
        runAtom(atom: 'jmeter', version: '1.latest', inputs: [
            pattern: '**/*.jtl'
          ])
      }
    }
  }
}
