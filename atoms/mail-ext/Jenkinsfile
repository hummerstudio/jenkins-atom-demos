// mail-ext @ 1.0.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 这个原子要外部服务/凭据：失败会被记录，流水线保持成功（continueOnError）。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/mail-ext/fixtures ]; then cp -R atoms/mail-ext/fixtures/. .; fi'

      }
    }

    stage('mail-ext') {
      steps {
        runAtom(atom: 'mail-ext', version: '1.0.0', inputs: [
            from: 'jenkins@localhost',
            subject: '[Jenkins] $PROJECT_NAME #$BUILD_NUMBER - $BUILD_STATUS',
            body: 'Build: $BUILD_URL
Result: $BUILD_STATUS

$BUILD_LOG_EXCERPT

$FAILED_TESTS'
          ],
          continueOnError: true)
      }
    }
  }
}
