// splunk action=event（原 splunk-hec） — 作业路径不变
// 这个原子要外部服务/凭据：失败会被记录，流水线保持成功（continueOnError）。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('splunk-hec') {
      steps {
        runAtom(atom: 'splunk', version: '1.latest', inputs: [
            action: 'event',
            sourcetype: 'jenkins',
            source: 'jenkins'
          ],
          continueOnError: true)
      }
    }
  }
}
