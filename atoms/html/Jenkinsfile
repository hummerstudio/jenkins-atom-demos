// html @ 1.2.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'out/coverage/index.html', text: '''<html><body><h1>coverage demo</h1></body></html>
'''
      }
    }

    stage('html') {
      steps {
        runAtom(atom: 'html', version: '1.latest', inputs: [
            path: 'out/coverage',
            index: 'index.html'
          ])
      }
    }
  }
}
