// git-changelog @ 1.0.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/git-changelog/fixtures ]; then cp -R atoms/git-changelog/fixtures/. .; fi'
        sh 'git checkout -B main'
      }
    }

    stage('git-changelog') {
      steps {
        runAtom(atom: 'git-changelog', version: '1.0.0', inputs: [
            until: 'HEAD',
            output: 'CHANGELOG.md'
          ])
      }
    }
  }
}
