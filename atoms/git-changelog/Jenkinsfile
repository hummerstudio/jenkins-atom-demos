// git-changelog @ 1.0.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        sh 'git checkout -B main'
      }
    }

    stage('git-changelog') {
      steps {
        runAtom(atom: 'git-changelog', version: '1.latest', inputs: [
            until: 'HEAD',
            output: 'CHANGELOG.md'
          ])
      }
    }
  }
}
