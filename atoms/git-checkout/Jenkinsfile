// git-checkout @ 1.1.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/git-checkout/fixtures ]; then cp -R atoms/git-checkout/fixtures/. .; fi'

      }
    }

    stage('git-checkout') {
      steps {
        runAtom(atom: 'git-checkout', version: '1.latest', inputs: [
            targetDir: '.',
            url: 'file:///Users/tangming/Codes/jenkins-atom-demos',
            branch: 'main'
          ])
      }
    }
  }
}
