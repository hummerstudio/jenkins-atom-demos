// git action=checkout（原 git-checkout） — 作业路径不变
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('git-checkout') {
      steps {
        runAtom(atom: 'git', version: '1.latest', inputs: [
            action: 'checkout',
            targetDir: '.',
            url: 'file:///Users/tangming/Codes/jenkins-atom-demos',
            branch: 'main'
          ])
      }
    }
  }
}
