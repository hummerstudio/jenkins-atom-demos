// cucumber @ 1.0.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'cucumber.json', text: '''[
  {
    "uri": "features/demo.feature",
    "id": "demo",
    "keyword": "Feature",
    "name": "Demo",
    "elements": [
      {
        "id": "demo;passes",
        "keyword": "Scenario",
        "name": "passes",
        "type": "scenario",
        "steps": [
          {"keyword": "Given ", "name": "a thing", "result": {"status": "passed", "duration": 1000000}},
          {"keyword": "Then ", "name": "it works", "result": {"status": "passed", "duration": 2000000}}
        ],
        "tags": []
      }
    ]
  }
]
'''
        writeFile file: 'reports/cucumber.json', text: '''[{"name":"demo","elements":[],"status":"passed"}]
'''
      }
    }

    stage('cucumber') {
      steps {
        runAtom(atom: 'cucumber', version: '1.latest', inputs: [
            pattern: '**/cucumber.json'
          ])
      }
    }
  }
}
