// aws-lambda-invoke @ 1.0.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 这个原子要外部服务/凭据：失败会被记录，流水线保持成功（continueOnError）。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/aws-lambda-invoke/fixtures ]; then cp -R atoms/aws-lambda-invoke/fixtures/. .; fi'

      }
    }

    stage('aws-lambda-invoke') {
      steps {
        runAtom(atom: 'aws-lambda-invoke', version: '1.latest',
          continueOnError: true)
      }
    }
  }
}
