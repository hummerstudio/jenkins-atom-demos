// ssh action=publish（原 ssh-publish） — 作业路径不变
// 这个原子要外部服务/凭据：失败会被记录，流水线保持成功（continueOnError）。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('ssh-publish') {
      steps {
        runAtom(atom: 'ssh', version: '1.latest', inputs: [
            action: 'publish',
            sourceFiles: '**/*',
            strictHostKeyChecking: 'accept-new'
          ],
          continueOnError: true)
      }
    }
  }
}
