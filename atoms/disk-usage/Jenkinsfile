// disk-usage @ 1.0.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('disk-usage') {
      steps {
        runAtom(atom: 'disk-usage', version: '1.latest', inputs: [
            outDir: 'out/disk'
          ])
      }
    }
  }
}
