// xunit @ 1.1.1 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/xunit/fixtures ]; then cp -R atoms/xunit/fixtures/. .; fi'
      }
    }

    stage('xunit') {
      steps {
        runAtom(atom: 'xunit', version: '1.1.1', inputs: [
            testResults: '**/TestResults/*.trx, **/*.trx, **/TestResults/*.xml, **/test-results*.xml, **/nunit*.xml, **/xunit*.xml'
          ])
      }
    }
  }
}
