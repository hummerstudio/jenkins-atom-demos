// python-env @ 1.0.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('python-env') {
      steps {
        runAtom(atom: 'python-env', version: '1.latest', inputs: [
            venv: '.venv'
          ])
      }
    }
  }
}
