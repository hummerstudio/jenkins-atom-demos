// splunk-devops @ 1.0.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 这个原子要外部服务/凭据：失败会被记录，流水线保持成功（continueOnError）。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/splunk-devops/fixtures ]; then cp -R atoms/splunk-devops/fixtures/. .; fi'
      }
    }

    stage('splunk-devops') {
      steps {
        runAtom(atom: 'splunk-devops', version: '1.0.0', inputs: [
            eventKind: 'job_event',
            jobEventType: 'completed',
            jobName: '${JOB_NAME}'
          ],
          continueOnError: true)
      }
    }
  }
}
