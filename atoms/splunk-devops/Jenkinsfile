// splunk action=build（原 splunk-devops） — 作业路径不变
// 这个原子要外部服务/凭据：失败会被记录，流水线保持成功（continueOnError）。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('splunk-devops') {
      steps {
        runAtom(atom: 'splunk', version: '1.latest', inputs: [
            action: 'build',
            eventKind: 'job_event',
            jobEventType: 'completed',
            jobName: '${JOB_NAME}'
          ],
          continueOnError: true)
      }
    }
  }
}
