// gradle @ 1.2.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'build.gradle', text: '''tasks.register('build') { doLast { println 'gradle build ok' } }
'''
        writeFile file: 'settings.gradle', text: '''rootProject.name = 'demo'
'''
      }
    }

    stage('gradle') {
      steps {
        runAtom(atom: 'gradle', version: '1.latest', inputs: [
            goals: 'build'
          ])
      }
    }
  }
}
