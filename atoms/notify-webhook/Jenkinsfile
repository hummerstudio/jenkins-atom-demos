// notify-webhook @ 1.0.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 这个原子要外部服务/凭据：失败会被记录，流水线保持成功（continueOnError）。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/notify-webhook/fixtures ]; then cp -R atoms/notify-webhook/fixtures/. .; fi'

      }
    }

    stage('notify-webhook') {
      steps {
        runAtom(atom: 'notify-webhook', version: '1.latest', inputs: [
            kind: 'slack',
            text: '${JOB_NAME} #${BUILD_NUMBER} ${BUILD_STATUS} — ${BUILD_URL}'
          ],
          continueOnError: true)
      }
    }
  }
}
