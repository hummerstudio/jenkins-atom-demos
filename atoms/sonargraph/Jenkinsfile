// sonargraph @ 1.0.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'target/sonargraph/sonargraph-report.xml', text: '''<?xml version="1.0" encoding="UTF-8"?>
<report>
  <metaData>
    <project>demo</project>
    <issueCategories>
      <category id="arch" name="Architecture"/>
    </issueCategories>
    <issueTypes>
      <issueType id="cycle" name="Cycle" severity="Error" category="arch"/>
    </issueTypes>
    <metricIds>
      <metricId id="NCCD" name="NCCD"/>
    </metricIds>
  </metaData>
  <analyzer>
    <issues/>
  </analyzer>
</report>
'''
      }
    }

    stage('sonargraph') {
      steps {
        runAtom(atom: 'sonargraph', version: '1.latest', inputs: [
            action: 'report',
            reportPath: 'target/sonargraph/sonargraph-report.xml',
            architectureViolationsAction: 'nothing'
          ])
      }
    }
  }
}
