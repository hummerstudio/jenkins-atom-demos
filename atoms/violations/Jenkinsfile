// violations @ 1.0.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/violations/fixtures ]; then cp -R atoms/violations/fixtures/. .; fi'

      }
    }

    stage('violations') {
      steps {
        runAtom(atom: 'violations', version: '1.latest', inputs: [
            reports: '**/checkstyle-result.xml, **/pmd.xml, **/cpd.xml, **/findbugsXml.xml',
            maxTotal: '-1',
            unstableTotal: '-1'
          ])
      }
    }
  }
}
