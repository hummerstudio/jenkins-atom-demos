// atom-basic-steps action=files-list（原 files-tool；output 改名 checksumFile） — 作业路径不变
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('files-tool') {
      steps {
        runAtom(atom: 'atom-basic-steps', version: '1.latest', inputs: [
            action: 'files-list',
            operation: 'sha256',
            pattern: '**/*.jar',
            checksumFile: 'checksums.sha256'
          ])
      }
    }
  }
}
