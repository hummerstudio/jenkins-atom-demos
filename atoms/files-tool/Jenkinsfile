// files-tool @ 1.2.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('files-tool') {
      steps {
        runAtom(atom: 'files-tool', version: '1.latest', inputs: [
            operation: 'sha256',
            pattern: '**/*.jar',
            output: 'checksums.sha256'
          ])
      }
    }
  }
}
