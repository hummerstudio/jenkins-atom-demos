// atom-basic-steps action=file-ops（原 file-ops；target 改名 dest） — 作业路径不变
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'dist/demo.jar', text: '''demo
'''
      }
    }

    stage('file-ops') {
      steps {
        runAtom(atom: 'atom-basic-steps', version: '1.latest', inputs: [
            action: 'file-ops',
            operation: 'copy',
            pattern: 'dist/*.jar',
            dest: 'out/copied'
          ])
      }
    }
  }
}
