// file-ops @ 1.0.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'dist/demo.jar', text: '''demo
'''
      }
    }

    stage('file-ops') {
      steps {
        runAtom(atom: 'file-ops', version: '1.latest', inputs: [
            operation: 'copy',
            pattern: 'dist/*.jar',
            target: 'out/copied'
          ])
      }
    }
  }
}
