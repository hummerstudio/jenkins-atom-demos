// file-ops @ 1.0.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/file-ops/fixtures ]; then cp -R atoms/file-ops/fixtures/. .; fi'

      }
    }

    stage('file-ops') {
      steps {
        runAtom(atom: 'file-ops', version: '1.0.0', inputs: [
            operation: 'copy',
            pattern: 'dist/*.jar',
            target: 'out/copied'
          ])
      }
    }
  }
}
