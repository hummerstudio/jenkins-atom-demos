// gcs action=upload（吸收 gcs-upload 的参数形态） — 作业路径不变
// 这个原子要外部服务/凭据：失败会被记录，流水线保持成功（continueOnError）。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('gcs-upload') {
      steps {
        runAtom(atom: 'gcs', version: '1.latest', inputs: [
            action: 'upload',
            files: '**/*.jar',
            tokenUrl: 'https://oauth2.googleapis.com/token',
            uploadUrl: 'https://storage.googleapis.com'
          ],
          continueOnError: true)
      }
    }
  }
}
