// gcs-upload @ 1.0.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 这个原子要外部服务/凭据：失败会被记录，流水线保持成功（continueOnError）。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/gcs-upload/fixtures ]; then cp -R atoms/gcs-upload/fixtures/. .; fi'

      }
    }

    stage('gcs-upload') {
      steps {
        runAtom(atom: 'gcs-upload', version: '1.latest', inputs: [
            files: '**/*.jar',
            tokenUrl: 'https://oauth2.googleapis.com/token',
            uploadUrl: 'https://storage.googleapis.com'
          ],
          continueOnError: true)
      }
    }
  }
}
