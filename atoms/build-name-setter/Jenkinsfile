// build-name-setter @ 1.2.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('build-name-setter') {
      steps {
        runAtom(atom: 'build-name-setter', version: '1.latest', inputs: [
            displayName: '#${BUILD_NUMBER}'
          ])
      }
    }
  }
}
