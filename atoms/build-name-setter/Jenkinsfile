// atom-basic-steps action=rename（原 build-name-setter 的同一动作）— 作业路径不变
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('build-name-setter') {
      steps {
        runAtom(atom: 'atom-basic-steps', version: '1.latest', inputs: [
            action: 'rename',
            displayName: '#${BUILD_NUMBER}'
          ])
      }
    }
  }
}
