// sonar @ 1.0.1 — 原子测试流水线；它需要的输入文件都写在这里
// 这个原子要外部服务/凭据：失败会被记录，流水线保持成功（continueOnError）。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('sonar') {
      steps {
        runAtom(atom: 'sonar', version: '1.latest', inputs: [
            hostUrl: 'https://sonarcloud.io',
            scanner: 'sonarner',
            sources: '.'
          ],
          continueOnError: true)
      }
    }
  }
}
