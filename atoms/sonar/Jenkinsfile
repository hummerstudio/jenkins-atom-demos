// sonar @ 1.0.1 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 这个原子要外部服务/凭据：失败会被记录，流水线保持成功（continueOnError）。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/sonar/fixtures ]; then cp -R atoms/sonar/fixtures/. .; fi'
      }
    }

    stage('sonar') {
      steps {
        runAtom(atom: 'sonar', version: '1.0.1', inputs: [
            hostUrl: 'https://sonarcloud.io',
            scanner: 'sonarner',
            sources: '.'
          ],
          continueOnError: true)
      }
    }
  }
}
