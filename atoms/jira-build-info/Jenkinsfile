// jira action=build — 原子测试流水线；jira-build-info 已并入 jira（action build / deployment），作业路径不变
// 这个原子要外部服务/凭据：失败会被记录，流水线保持成功（continueOnError）。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('jira build') {
      steps {
        runAtom(atom: 'jira', version: '1.latest', inputs: [
            action: 'build',
            projectName: '${JOB_NAME}',
            buildNumber: '${BUILD_NUMBER}'
          ],
          continueOnError: true)
      }
    }
  }
}
