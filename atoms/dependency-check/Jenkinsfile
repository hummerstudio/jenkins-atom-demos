// dependency-check @ 1.1.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'dependency-check-report.xml', text: '''<?xml version="1.0" encoding="UTF-8"?>
<analysis xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
  <scanInfo><engineVersion>1.0</engineVersion></scanInfo>
  <projectInfo><name>demo</name></projectInfo>
  <dependencies>
    <dependency isVirtual="false">
      <fileName>demo.jar</fileName>
      <filePath>/workspace/dist/demo.jar</filePath>
      <md5>d41d8cd98f00b204e9800998ecf8427e</md5>
      <sha1>da39a3ee5e6b4b0d3255bfef95601890afd80709</sha1>
      <sha256>e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855</sha256>
      <evidence/>
      <vulnerabilities/>
    </dependency>
  </dependencies>
</analysis>
'''
      }
    }

    stage('dependency-check') {
      steps {
        runAtom(atom: 'dependency-check', version: '1.latest', inputs: [
            pattern: '**/dependency-check-report.xml',
            maxHigh: '-1',
            maxTotal: '-1'
          ])
      }
    }
  }
}
