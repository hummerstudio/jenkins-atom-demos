// dependency-check @ 1.1.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/dependency-check/fixtures ]; then cp -R atoms/dependency-check/fixtures/. .; fi'
      }
    }

    stage('dependency-check') {
      steps {
        runAtom(atom: 'dependency-check', version: '1.1.0', inputs: [
            pattern: '**/dependency-check-report.xml',
            maxHigh: '-1',
            maxTotal: '-1'
          ])
      }
    }
  }
}
