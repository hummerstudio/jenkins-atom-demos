// selenium-html-report @ 1.0.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'target/index.html', text: '''<html><head><title>Selenium report</title></head><body>
<table cellpadding="2" cellspacing="0" border="1">
<tr><td rowspan="1" colspan="3">demo suite</td></tr>
<tr><td>result:</td><td>passed</td></tr>
<tr><td>totalTime:</td><td>42</td></tr>
<tr><td>numTestTotal:</td><td>4</td></tr>
<tr><td>numTestPasses:</td><td>4</td></tr>
<tr><td>numTestFailures:</td><td>0</td></tr>
<tr><td>numCommandPasses:</td><td>42</td></tr>
<tr><td>numCommandFailures:</td><td>0</td></tr>
<tr><td>numCommandErrors:</td><td>0</td></tr>
<tr><td>open</td><td>/</td><td></td></tr>
</table>
</body></html>
'''
      }
    }

    stage('selenium-html-report') {
      steps {
        runAtom(atom: 'selenium-html-report', version: '1.latest', inputs: [
            testResultsDir: 'target'
          ])
      }
    }
  }
}
