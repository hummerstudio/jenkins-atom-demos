// selenium-html-report @ 1.0.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/selenium-html-report/fixtures ]; then cp -R atoms/selenium-html-report/fixtures/. .; fi'
      }
    }

    stage('selenium-html-report') {
      steps {
        runAtom(atom: 'selenium-html-report', version: '1.0.0', inputs: [
            testResultsDir: 'target'
          ])
      }
    }
  }
}
