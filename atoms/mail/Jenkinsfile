// mail @ 2.0.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 这个原子要外部服务/凭据：失败会被记录，流水线保持成功（continueOnError）。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/mail/fixtures ]; then cp -R atoms/mail/fixtures/. .; fi'
      }
    }

    stage('mail') {
      steps {
        runAtom(atom: 'mail', version: '2.0.0', inputs: [
            to: '<填:收件人（逗号分隔，支持 ${ENV}）>',
            smtpHost: '<填:SMTP 主机>',
            subject: '[Jenkins] $PROJECT_NAME #$BUILD_NUMBER - $BUILD_STATUS'
          ],
          continueOnError: true)
      }
    }
  }
}
