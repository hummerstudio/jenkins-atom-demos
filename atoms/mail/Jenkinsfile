// mail @ 2.0.0 — 原子测试流水线；它需要的输入文件都写在这里
// 这个原子要外部服务/凭据：失败会被记录，流水线保持成功（continueOnError）。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('mail') {
      steps {
        runAtom(atom: 'mail', version: '2.latest', inputs: [
            to: '<填:收件人（逗号分隔，支持 ${ENV}）>',
            smtpHost: '<填:SMTP 主机>',
            subject: '[Jenkins] $PROJECT_NAME #$BUILD_NUMBER - $BUILD_STATUS'
          ],
          continueOnError: true)
      }
    }
  }
}
