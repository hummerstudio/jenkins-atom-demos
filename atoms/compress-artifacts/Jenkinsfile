// atom-basic-steps action=compress（原 compress-artifacts）— 作业路径不变
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('compress-artifacts') {
      steps {
        runAtom(atom: 'atom-basic-steps', version: '1.latest', inputs: [
            action: 'compress',
            patterns: '**/*',
            outputFile: 'artifacts.zip'
          ])
      }
    }
  }
}
