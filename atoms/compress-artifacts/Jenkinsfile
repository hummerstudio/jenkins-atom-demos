// compress-artifacts @ 1.0.1 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('compress-artifacts') {
      steps {
        runAtom(atom: 'compress-artifacts', version: '1.latest', inputs: [
            patterns: '**/*',
            outputFile: 'artifacts.zip'
          ])
      }
    }
  }
}
