// build-tool @ 1.0.0 — 原子测试流水线；Maven/Ant/Gradle 合一后跑 mvn -v，验证 tool 派发
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('build-tool') {
      steps {
        runAtom(atom: 'build-tool', version: '1.latest', inputs: [
            tool: 'maven',
            goals: '-v'
          ])
      }
    }
  }
}
