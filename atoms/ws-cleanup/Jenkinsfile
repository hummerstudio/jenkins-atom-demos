// ws-cleanup @ 1.2.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('ws-cleanup') {
      steps {
        runAtom(atom: 'ws-cleanup', version: '1.latest', inputs: [
            patterns: '**/target, **/build'
          ])
      }
    }
  }
}
