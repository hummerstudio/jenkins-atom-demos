// ws-cleanup @ 1.2.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/ws-cleanup/fixtures ]; then cp -R atoms/ws-cleanup/fixtures/. .; fi'
      }
    }

    stage('ws-cleanup') {
      steps {
        runAtom(atom: 'ws-cleanup', version: '1.2.0', inputs: [
            patterns: '**/target, **/build'
          ])
      }
    }
  }
}
