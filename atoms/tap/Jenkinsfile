// tap @ 1.1.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'results/demo.tap', text: '''1..2
ok 1 - first
ok 2 - second
'''
      }
    }

    stage('tap') {
      steps {
        runAtom(atom: 'tap', version: '1.latest', inputs: [
            pattern: '**/*.tap, **/Testing/**/Test.xml, **/test-results/*.tap'
          ])
      }
    }
  }
}
