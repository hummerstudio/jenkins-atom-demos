// code-stats @ 1.0.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/code-stats/fixtures ]; then cp -R atoms/code-stats/fixtures/. .; fi'

      }
    }

    stage('code-stats') {
      steps {
        runAtom(atom: 'code-stats', version: '1.latest', inputs: [
            includes: '**/*.java, **/*.py, **/*.js, **/*.ts, **/*.go, **/*.rs, **/*.c, **/*.cpp, **/*.h, **/*.kt, **/*.sh, **/*.yml, **/*.xml, **/*.md',
            excludes: '**/target/**, **/build/**, **/node_modules/**, **/.git/**, **/dist/**, **/out/**'
          ])
      }
    }
  }
}
