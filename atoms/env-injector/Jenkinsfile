// env-injector @ 1.0.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: '.env', text: '''APP_ENV=demo
FROM_FILE=1
'''
      }
    }

    stage('env-injector') {
      steps {
        runAtom(atom: 'env-injector', version: '1.latest', inputs: [
            files: '.env'
          ])
      }
    }
  }
}
