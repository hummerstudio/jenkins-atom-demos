// text-finder @ 1.1.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/text-finder/fixtures ]; then cp -R atoms/text-finder/fixtures/. .; fi'

      }
    }

    stage('text-finder') {
      steps {
        runAtom(atom: 'text-finder', version: '1.1.0', inputs: [
            buildResult: 'FAILURE',
            regexp: 'ERROR',
            fileSet: 'build.log'
          ])
      }
    }
  }
}
