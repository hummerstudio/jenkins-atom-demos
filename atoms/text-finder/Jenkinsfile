// text-finder @ 1.1.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'build.log', text: '''2026-11-04 10:00:00 INFO starting
2026-11-04 10:00:01 WARN slow step
2026-11-04 10:00:02 ERROR boom
'''
      }
    }

    stage('text-finder') {
      steps {
        runAtom(atom: 'text-finder', version: '1.latest', inputs: [
            buildResult: 'FAILURE',
            regexp: 'NEVER_MATCHES_ANYWHERE',
            useBuildLog: 'false',
            fileSet: 'build.log'
          ])
      }
    }
  }
}
