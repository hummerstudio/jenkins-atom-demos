// atom-basic-steps action=find-text（原 text-finder） — 作业路径不变
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'build.log', text: '''2026-11-04 10:00:00 INFO starting
2026-11-04 10:00:01 WARN slow step
2026-11-04 10:00:02 ERROR boom
'''
      }
    }

    stage('text-finder') {
      steps {
        runAtom(atom: 'atom-basic-steps', version: '1.latest', inputs: [
            action: 'find-text',
            buildResult: 'FAILURE',
            regexp: 'NEVER_MATCHES_ANYWHERE',
            useBuildLog: 'false',
            fileSet: 'build.log'
          ])
      }
    }
  }
}
