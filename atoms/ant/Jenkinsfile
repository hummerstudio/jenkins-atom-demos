// ant @ 1.2.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'build.xml', text: '''<project name="demo" default="build">
  <target name="build"><echo>ant build ok</echo></target>
</project>
'''
      }
    }

    stage('ant') {
      steps {
        runAtom(atom: 'ant', version: '1.latest')
      }
    }
  }
}
