// atom-basic-steps action=zip（原 zip-artifacts）— 作业路径不变
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('zip-artifacts') {
      steps {
        runAtom(atom: 'atom-basic-steps', version: '1.latest', inputs: [
            action: 'zip',
            archive: 'artifacts.zip',
            includes: '**/*'
          ])
      }
    }
  }
}
