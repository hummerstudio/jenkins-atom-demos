// zip-artifacts @ 1.0.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/zip-artifacts/fixtures ]; then cp -R atoms/zip-artifacts/fixtures/. .; fi'
      }
    }

    stage('zip-artifacts') {
      steps {
        runAtom(atom: 'zip-artifacts', version: '1.0.0', inputs: [
            operation: 'zip',
            archive: 'artifacts.zip',
            includes: '**/*'
          ])
      }
    }
  }
}
