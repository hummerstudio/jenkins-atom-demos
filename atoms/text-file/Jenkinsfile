// text-file @ 1.0.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/text-file/fixtures ]; then cp -R atoms/text-file/fixtures/. .; fi'

      }
    }

    stage('text-file') {
      steps {
        runAtom(atom: 'text-file', version: '1.0.0', inputs: [
            option: 'create',
            lineSeparator: 'platform',
            path: 'notes.txt',
            content: 'hello'
          ])
      }
    }
  }
}
