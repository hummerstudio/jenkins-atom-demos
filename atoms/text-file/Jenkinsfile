// atom-basic-steps action=write-file（原 text-file） — 作业路径不变
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('text-file') {
      steps {
        runAtom(atom: 'atom-basic-steps', version: '1.latest', inputs: [
            action: 'write-file',
            option: 'overwrite',
            lineSeparator: 'platform',
            path: 'notes.txt',
            content: 'hello'
          ])
      }
    }
  }
}
