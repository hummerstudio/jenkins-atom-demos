// json-tool @ 1.0.1 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/json-tool/fixtures ]; then cp -R atoms/json-tool/fixtures/. .; fi'
      }
    }

    stage('json-tool') {
      steps {
        runAtom(atom: 'json-tool', version: '1.0.1', inputs: [
            operation: 'read',
            file: 'package.json'
          ])
      }
    }
  }
}
