// atom-basic-steps action=json（原 json-tool；path 改名 jsonPath） — 作业路径不变
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'package.json', text: '''{"name":"demo","version":"1.0.0","scripts":{"test":"echo ok"}}
'''
      }
    }

    stage('json-tool') {
      steps {
        runAtom(atom: 'atom-basic-steps', version: '1.latest', inputs: [
            action: 'json',
            operation: 'read',
            file: 'package.json'
          ])
      }
    }
  }
}
