// json-tool @ 1.0.1 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'package.json', text: '''{"name":"demo","version":"1.0.0","scripts":{"test":"echo ok"}}
'''
      }
    }

    stage('json-tool') {
      steps {
        runAtom(atom: 'json-tool', version: '1.latest', inputs: [
            operation: 'read',
            file: 'package.json'
          ])
      }
    }
  }
}
