// http-request @ 1.2.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/http-request/fixtures ]; then cp -R atoms/http-request/fixtures/. .; fi'
      }
    }

    stage('http-request') {
      steps {
        runAtom(atom: 'http-request', version: '1.2.0', inputs: [
            url: '<填:URL（支持 ${BUILD_NUMBER} 等环境变量）>',
            method: 'GET',
            expectStatus: '2xx'
          ])
      }
    }
  }
}
