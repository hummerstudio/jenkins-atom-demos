// http-request @ 1.2.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('http-request') {
      steps {
        runAtom(atom: 'http-request', version: '1.latest', inputs: [
            url: 'http://127.0.0.1:8098/api/json',
            method: 'GET',
            expectStatus: '2xx'
          ])
      }
    }
  }
}
