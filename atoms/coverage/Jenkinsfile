// coverage @ 1.3.2 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'coverage.xml', text: '''<?xml version="1.0" encoding="UTF-8"?>
<report name="demo"><counter type="LINE" missed="1" covered="9"/><counter type="BRANCH" missed="0" covered="4"/></report>
'''
        writeFile file: 'lcov.info', text: '''TN:
SF:src/main/java/demo/App.java
LF:10
LH:9
end_of_record
'''
        writeFile file: 'target/site/jacoco/jacoco.xml', text: '''<?xml version="1.0" encoding="UTF-8"?>
<report name="demo"><counter type="LINE" missed="1" covered="9"/><counter type="BRANCH" missed="0" covered="4"/></report>
'''
      }
    }

    stage('coverage') {
      steps {
        runAtom(atom: 'coverage', version: '1.latest', inputs: [
            pattern: '**/jacoco.xml, **/cobertura-coverage.xml, **/coverage.xml, **/lcov.info'
          ])
      }
    }
  }
}
