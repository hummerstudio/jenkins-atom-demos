// coverage @ 1.3.2 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/coverage/fixtures ]; then cp -R atoms/coverage/fixtures/. .; fi'
      }
    }

    stage('coverage') {
      steps {
        runAtom(atom: 'coverage', version: '1.3.2', inputs: [
            pattern: '**/jacoco.xml, **/cobertura-coverage.xml, **/coverage.xml, **/lcov.info'
          ])
      }
    }
  }
}
