// robot @ 1.0.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/robot/fixtures ]; then cp -R atoms/robot/fixtures/. .; fi'

      }
    }

    stage('robot') {
      steps {
        runAtom(atom: 'robot', version: '1.latest', inputs: [
            pattern: '**/output.xml'
          ])
      }
    }
  }
}
