// robot @ 1.0.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'output.xml', text: '''<?xml version="1.0" encoding="UTF-8"?>
<robot generator="Robot 7.0" generated="2026-11-04T10:00:00" rpa="false" schemaversion="4">
  <suite id="s1" name="Demo">
    <test id="s1-t1" name="Passes">
      <status status="PASS" start="2026-11-04T10:00:00" elapsed="0.012"/>
    </test>
    <status status="PASS" start="2026-11-04T10:00:00" elapsed="0.013"/>
  </suite>
  <statistics>
    <total>
      <stat pass="1" fail="0" skip="0">All Tests</stat>
    </total>
    <tag/>
    <suite>
      <stat pass="1" fail="0" skip="0" id="s1" name="Demo">Demo</stat>
    </suite>
  </statistics>
  <errors/>
</robot>
'''
      }
    }

    stage('robot') {
      steps {
        runAtom(atom: 'robot', version: '1.latest', inputs: [
            pattern: '**/output.xml'
          ])
      }
    }
  }
}
