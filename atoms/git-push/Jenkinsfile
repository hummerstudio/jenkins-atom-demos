// git action=push — 原子测试流水线；git-push 已并入 git，作业路径保持不变
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        sh 'git checkout -B main'
        sh 'git init -q --bare "$WORKSPACE/../push-target.git"'
        sh 'git remote set-url origin "$WORKSPACE/../push-target.git"'
        sh 'git config user.email atom@example.com'
        sh 'git config user.name atom'
      }
    }

    stage('git push') {
      steps {
        runAtom(atom: 'git', version: '1.latest', inputs: [
            action: 'push',
            remote: 'origin'
          ])
      }
    }
  }
}
