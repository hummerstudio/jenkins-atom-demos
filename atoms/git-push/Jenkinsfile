// git-push @ 1.0.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        sh 'git checkout -B main'
        sh 'git init -q --bare "$WORKSPACE/../push-target.git"'
        sh 'git remote set-url origin "$WORKSPACE/../push-target.git"'
        sh 'git config user.email atom@example.com'
        sh 'git config user.name atom'
      }
    }

    stage('git-push') {
      steps {
        runAtom(atom: 'git-push', version: '1.latest', inputs: [
            remote: 'origin'
          ])
      }
    }
  }
}
