// github action=checks（原 github-checks） — 作业路径不变
// 这个原子要外部服务/凭据：失败会被记录，流水线保持成功（continueOnError）。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('github-checks') {
      steps {
        runAtom(atom: 'github', version: '1.latest', inputs: [
            action: 'checks',
            status: 'completed',
            apiUrl: 'https://api.github.com'
          ],
          continueOnError: true)
      }
    }
  }
}
