// sbt @ 1.0.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'build.sbt', text: '''name := "demo"
scalaVersion := "2.13.14"
'''
        writeFile file: 'project/build.properties', text: '''sbt.version=1.10.7
'''
      }
    }

    stage('sbt') {
      steps {
        runAtom(atom: 'sbt', version: '1.latest', inputs: [
            actions: 'compile',
            sbtOptions: '-Dsbt.log.noformat=true'
          ])
      }
    }
  }
}
