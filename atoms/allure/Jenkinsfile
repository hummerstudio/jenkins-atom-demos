// allure @ 1.1.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('准备') {
      steps {
        writeFile file: 'allure-results/demo-result.json', text: '''{"name":"demo","status":"passed","statusDetails":{},"stage":"finished","steps":[],"attachments":[]}
'''
      }
    }

    stage('allure') {
      steps {
        runAtom(atom: 'allure', version: '1.latest', inputs: [
            resultsDir: 'allure-results',
            reportDir: 'out/allure',
            title: 'Allure report'
          ])
      }
    }
  }
}
