// allure @ 1.1.0 — 生成的测试流水线，fixtures 在 atoms/_shared/fixtures
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('fixtures') {
      steps {
        sh 'cp -R atoms/_shared/fixtures/. .'
        sh 'if [ -d atoms/allure/fixtures ]; then cp -R atoms/allure/fixtures/. .; fi'
      }
    }

    stage('allure') {
      steps {
        runAtom(atom: 'allure', version: '1.1.0', inputs: [
            resultsDir: 'allure-results',
            reportDir: 'out/allure',
            title: 'Allure report'
          ])
      }
    }
  }
}
