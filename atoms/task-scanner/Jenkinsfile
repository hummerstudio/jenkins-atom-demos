// task-scanner @ 1.0.0 — 原子测试流水线；它需要的输入文件都写在这里
// 原子失败即构建失败。
pipeline {
  agent any
  options { timeout(time: 5, unit: 'MINUTES') }

  stages {
    stage('task-scanner') {
      steps {
        runAtom(atom: 'task-scanner', version: '1.latest', inputs: [
            includes: '**/*.java, **/*.kt, **/*.js, **/*.ts, **/*.py, **/*.go, **/*.rs, **/*.c, **/*.cpp, **/*.h, **/*.sh, **/*.rb, **/*.php, **/*.cs',
            excludes: '**/target/**, **/build/**, **/node_modules/**, **/.git/**, **/dist/**, **/out/**',
            markers: 'TODO, FIXME, XXX, HACK'
          ])
      }
    }
  }
}
